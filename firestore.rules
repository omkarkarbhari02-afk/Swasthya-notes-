rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() &&
        (request.auth.token.role == 'OWNER' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER');
    }

    function isOwnerOrSelf(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isOwner());
    }

    function hasApprovedAccess(contentId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/access_permissions/$(request.auth.uid + '_' + contentId));
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwnerOrSelf(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuspended']));
      allow delete: if isOwner();
    }

    // 2. Content items collection (Years, Subjects, Folders, Chapters, PDFs, PYQs)
    match /content_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // 3. Access Requests collection (Manual Approval Flow)
    match /access_requests/{requestId} {
      allow read: if isOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // 4. Access Permissions collection
    match /access_permissions/{permissionId} {
      allow read: if isOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isOwner();
    }

    // 5. System Settings (Owner UPI, QR Code, Bundle Prices)
    match /app_settings/{settingKey} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // 6. Broadcast Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
  }
}
